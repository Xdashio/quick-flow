DATABASE_URL="postgresql://pos_user:pos_password@localhost:5432/pos_db?schema=public"
PORT=3000
JWT_SECRET="change-me-in-production"
# Comma-separated list of origins allowed to call the API with credentials (cookies).
# Must be explicit origins — CORS blocks wildcard '*' whenever credentials are included.
CORS_ORIGIN="http://localhost:3001,http://localhost:3000"
DARAJA_ENV="sandbox"
DARAJA_CONSUMER_KEY=""
DARAJA_CONSUMER_SECRET=""
DARAJA_SHORTCODE=""
DARAJA_PASSKEY=""
DARAJA_CALLBACK_URL="https://your-ngrok-url/api/payments/mpesa/callback"

# Cloudflare R2 (S3-compatible) — product image storage
# Local: copy these values into backend/.env (never commit .env).
# Prod (Railway/server): set the SAME variable names as enprojectnment variables
# on the hosting provider. The backend reads backend/.env locally and the
# hosting env vars in prod; DATABASE_URL works the same way (Supabase locally,
# Postgres instance in prod). Only presigned uploadUrl + object key are ever
# sent to the browser — secrets never leave the server.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="pos-product-images"
R2_PUBLIC_URL="https://images.yourdomain.com"
